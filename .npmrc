# Taro 4.1.9 的依赖树里 @tarojs/taro-loader 要求 peer webpack@5.91.0，
# 而本项目锁定 webpack@5.78.0，npm 7+ 会直接 ERESOLVE 失败（本地 node_modules
# 当初也是按 legacy 方式装的，所以只在全新安装的环境——例如 Vercel 构建机——才暴露）。
# 这里统一关掉严格 peer 校验，保证 CI/Vercel 上 `npm install` 可以通过。
legacy-peer-deps=true

# 关掉 npm 的更新提示与审计请求，构建日志更干净、少一次网络往返
fund=false
audit=false
