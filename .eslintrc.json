{
  "root": true,
  "extends": ["taro/react"],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "dist-h5/**", "config/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "import/first": "off"
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-quotes": ["error", "prefer-double"]
  }
}
