# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
.venv/
venv/

# Node
node_modules/
dist/
.taro-cache/
.temp/

# Model files (too large for git)
backend/models/

# Data files
backend/data/raw/
backend/data/processed/
backend/data/cms.db
backend/database.sqlite3

# Uploaded user files (avatars etc.)
backend/static/*
# 内置课程/项目封面占位图（随仓库提交，运行时由后端 /static 提供）
!backend/static/covers/

# Environment
.env
.env.local

# Local IDE / tool config
project.private.config.json
.claude/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# WorkBuddy internal state (not project source)
.workbuddy/

# IDE / 辅助工具私有配置（含内部训练方案文档，不入公共仓库）
.pai/
.trae/

# Frontend H5 build output (regenerable via npm run build:h5)
dist-h5/

# 本地私有文档（合同/协议/证件等个人材料，绝不进公开仓库）
docs/private/

# User scripts / binary docs (per project agreement, not committed)
scripts/
*.docx
.vercel
.env*
