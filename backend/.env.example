# ============================================================
# AI 教学服务平台 · 后端环境变量示例
# 复制为 backend/.env 并填入真实值（.env 已被 gitignore，切勿提交）
# ============================================================

# ---------- 服务监听 ----------
# 端口默认 8010（8000 常被本机其它服务占用）；改这里时前端 dev 代理要同步：
#   DEV_API_TARGET=http://localhost:<PORT> npm run dev:h5
HOST=0.0.0.0
PORT=8010

# ---------- 登录态 Token（HMAC 签名） ----------
# 生产环境务必替换为足够长的随机串！否则 token 可被伪造。
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRE_DAYS=30

# ---------- AI（智谱 GLM 为主 + DeepSeek 可选） ----------
# 从 https://open.bigmodel.cn 获取 API Key；线上主路径使用它做导师问答 / 岗位对标。
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 可选：DeepSeek key（standard/pro 档：作业评审走 reasoner 更强、标准档更省）。不填则全部走智谱。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ---------- 数据库（SQLite 默认 / MySQL 生产） ----------
# sqlite = 本地 data/cms.db；mysql = 生产 MySQL（SQL 运行时方言翻译，见 DEPLOY.md §5）
# 部署到 Vercel 见 DEPLOY-VERCEL.md：云端必须用公网 MySQL（推荐 TiDB Cloud Serverless）
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_teach

# 云数据库 TLS（TiDB Cloud Serverless 强制 TLS）
# - DB_SSL_CA：CA 证书 PEM 内容或文件路径；给了就严格校验（推荐用 TiDB 控制台下载的 PEM）
# - 不给 CA 时：非本机地址默认「只加密不校验」；本机默认不开，避免本地 MySQL 未启 TLS 时连不上
# - DB_SSL_REQUIRED=false 可显式关闭
DB_SSL_CA=
DB_SSL_REQUIRED=

# 调用云端大模型的 HTTP 超时（秒）。Vercel 上默认 15（函数上限 60s），本机默认 60
AI_HTTP_TIMEOUT=

# H5 生产域名（跨域白名单追加，逗号分隔）
ALLOWED_CORS_ORIGINS=

# Vercel Blob（对象存储）：在 Vercel 项目里创建 Blob Store 后自动注入，
# 配了才能上传头像（Serverless 部署目录只读，写不了本地 static/avatars）
BLOB_READ_WRITE_TOKEN=

# ---------- 微信小程序登录 ----------
# 小程序后台「开发管理 → 开发设置」获取 AppID / AppSecret。
# 生产环境必填，否则无法用真实微信账号登录。
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# ---------- H5（手机浏览器）登录 ----------
# 网页端没有 wx.login，用手机号映射身份（openid=h5_<手机号>），复用同一张 users 表与 token。
# ⚠️ 置 true 时当前版本不校验短信验证码（等价于知道手机号即可登录），仅适合内测；
#    上线前请补短信验证码或改微信网页授权，或先把这里置 false 关掉网页端登录入口。
H5_PHONE_LOGIN=true

# ---------- 微信支付（押金收付，V3 商户号） ----------
# 不配置则押金报名/退费走「占位」路径（仅记状态不真实收钱）。
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=/app/certs/apiclient_key.pem
WXPAY_APIV3_KEY=
WXPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
WXPAY_REFUND_NOTIFY_URL=https://your-domain.com/api/pay/notify

# ---------- 微信订阅消息（学习/打卡/作业提醒） ----------
# 小程序后台「订阅消息」申请模板后填入对应 ID；未填则静默不推送。
WX_SUB_TEMPLATE_CHECKIN=
WX_SUB_TEMPLATE_HOMEWORK=
WX_SUB_TEMPLATE_LEARNING=

# ---------- 开发模式 ----------
# true  = 接受任意 code 生成开发用户（无需真实微信环境），便于本地联调
# false = 必须使用真实微信 AppID/Secret 走 code2session（生产必须）
DEV_MODE=false

# ---------- 押金式培训参数（对照《商业评审报告·押金式培训版》） ----------
DEPOSIT_AMOUNT=199.00          # 默认培训押金（元）
DEPOSIT_TIME_LOCK_DAYS=90      # 时间锁：报名后 90 天内须完成课程+考核
DEPOSIT_STAGES=7               # 七阶段课程 / 七阶段考核
DEPOSIT_PASS_SCORE=85          # 考核锁：七阶段均分 ≥85 才达标
DEPOSIT_REFUND_WORKING_DAYS=15 # 退费时效：最终考核通过后 15 个工作日内到账
